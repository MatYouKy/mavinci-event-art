# Sekrety funkcji Edge dla nowego projektu. Format: NAZWA=wartość (bez spacji wokół =, bez cudzysłowów).
# Puste pole = wartość domyślna w kodzie funkcji. Skrypt porówna wpisane wartości ze starym projektem (po skrótach).
# SUPABASE_URL, SUPABASE_ANON_KEY i SUPABASE_SERVICE_ROLE_KEY ustawia Supabase — nie wpisuj ich.

# Te same wartości co w konfiguracji CRM na serwerze (zmienne o tych samych nazwach):
OPENAI_API_KEY=
SMTP_RELAY_URL=
SMTP_RELAY_SECRET=

# Modele OpenAI — jeśli w konfiguracji CRM są zmienne o tych nazwach, przepisz; inaczej zostaw puste:
OPENAI_INQUIRY_ASSISTANT_MODEL=
OPENAI_FINANCIAL_MODEL=
OPENAI_TRANSLATION_MODEL=
OPENAI_INVOICE_SCAN_MODEL=
OPENAI_EMAIL_CLASSIFIER_MODEL=
OPENAI_CONTRACT_AUDIT_MODEL=
OPENAI_BANK_ANALYSIS_MODEL=

# Wewnętrzne sekrety funkcji — zostaw puste, skrypt wygeneruje nowe:
INTERNAL_FUNCTION_SECRET=
SUBCONTRACTOR_REMINDER_SECRET=
MARKETING_WORKER_SECRET=

# Adresy w e-mailach — puste = https://mavinci.pl:
PUBLIC_APP_URL=
FRONTEND_URL=
